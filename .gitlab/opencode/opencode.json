{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/gpt-5.6-sol",
  "small_model": "litellm/gpt-5.6-luna",
  "share": "disabled",
  "enabled_providers": [
    "litellm"
  ],
  "provider": {
    "litellm": {
      "name": "Internal LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.toy/v1",
        "streamOptions": {
          "includeUsage": false
        },
        "timeout": 1200000
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "deny",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow"
    },
    "edit": "deny",
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "deny"
  }
}
