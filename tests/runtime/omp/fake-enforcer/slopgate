#!/usr/bin/env bun

import { randomUUID } from "node:crypto";
import { rename } from "node:fs/promises";

const DEFAULT_RESPONSE = "{}";

class InvalidExitCodeError extends Error {
	constructor(readonly rawExitCode: string) {
		super(`Invalid SLOPGATE_FAKE_EXIT_CODE: ${rawExitCode}`);
		this.name = "InvalidExitCodeError";
	}
}

function parseExitCode(rawExitCode: string | undefined): number {
	if (rawExitCode === undefined) return 0;
	const exitCode = Number(rawExitCode);
	if (!Number.isInteger(exitCode) || exitCode < 0 || exitCode > 255) {
		throw new InvalidExitCodeError(rawExitCode);
	}
	return exitCode;
}

const FAKE_MODE = process.env.SLOPGATE_FAKE_MODE;
const pidsPath = process.env.SLOPGATE_FAKE_PIDS_PATH;

if (FAKE_MODE === "ignore-stdin") {
	// Exit cleanly without reading the payload, so an oversized write loses its reader.
	process.exit(0);
}

if (FAKE_MODE === "hang") {
	// Publish the pid barrier for this process and a grandchild, then never exit.
	const grandchild = Bun.spawn(["sleep", "3600"], { stdin: "ignore", stdout: "ignore", stderr: "ignore" });
	if (pidsPath !== undefined) {
		const temporaryPath = `${pidsPath}.${process.pid}.${randomUUID()}.tmp`;
		await Bun.write(temporaryPath, JSON.stringify({ child: process.pid, grandchild: grandchild.pid }));
		await rename(temporaryPath, pidsPath);
	}
	await new Promise<never>(() => {
		setInterval(() => {}, 1000);
	});
}

const stdin = await Bun.stdin.arrayBuffer();
const recordPath = process.env.SLOPGATE_FAKE_RECORD_PATH;
if (recordPath !== undefined) {
	await Bun.write(recordPath, stdin);
}

const logPath = process.env.SLOPGATE_FAKE_LOG_PATH;
if (logPath !== undefined) {
	// One line per invocation proves how many evaluations ran, whatever the response.
	const parsed: unknown = JSON.parse(new TextDecoder().decode(stdin));
	const eventName = typeof parsed === "object" && parsed !== null && "hook_event_name" in parsed
		? String(parsed.hook_event_name)
		: "";
	await Bun.write(logPath, `${(await Bun.file(logPath).exists() ? await Bun.file(logPath).text() : "")}${eventName}\n`);
}

const realBinary = process.env.SLOPGATE_FAKE_REAL_BIN;
if (realBinary !== undefined) {
	const child = Bun.spawn([realBinary, ...process.argv.slice(2)], {
		cwd: process.cwd(),
		env: process.env,
		stdin: new Blob([stdin]),
		stdout: "pipe",
		stderr: "pipe",
	});
	const [exitCode, stdout, stderr] = await Promise.all([
		child.exited,
		new Response(child.stdout).arrayBuffer(),
		new Response(child.stderr).arrayBuffer(),
	]);
	process.stdout.write(new Uint8Array(stdout));
	process.stderr.write(new Uint8Array(stderr));
	process.exitCode = exitCode;
} else {
	const stdout = process.env.SLOPGATE_FAKE_STDOUT ?? process.env.SLOPGATE_FAKE_RESPONSE ?? DEFAULT_RESPONSE;
	process.stdout.write(stdout);
	process.exitCode = parseExitCode(process.env.SLOPGATE_FAKE_EXIT_CODE);
}
