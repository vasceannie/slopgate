#!/bin/bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if [[ "${script_path}" != /* ]]; then
    script_path="${PWD}/${script_path}"
fi
readonly WRAPPER_PATH="$(readlink -f -- "${script_path}")"
readonly GITNEXUS_BIN="${GITNEXUS_BIN:-${HOME}/.local/bin/gitnexus}"

if [[ ! -x "${GITNEXUS_BIN}" ]]; then
    printf 'GitNexus binary is not executable: %s\n' "${GITNEXUS_BIN}" >&2
    exit 1
fi

if [[ "$(readlink -f -- "${GITNEXUS_BIN}")" == "${WRAPPER_PATH}" ]]; then
    printf 'GitNexus binary resolves to wrapper: %s\n' "${GITNEXUS_BIN}" >&2
    exit 1
fi

exec "${GITNEXUS_BIN}" "$@"
