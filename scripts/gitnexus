#!/bin/bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
if [[ "${script_path}" != /* ]]; then
    script_path="${PWD}/${script_path}"
fi
readonly GITNEXUS_BIN="${GITNEXUS_BIN:-${HOME}/.local/bin/gitnexus}"

if [[ ! -x "${GITNEXUS_BIN}" ]]; then
    printf 'GitNexus binary is not executable: %s\n' "${GITNEXUS_BIN}" >&2
    exit 1
fi

# Compare device and inode rather than canonical-path strings: ``readlink -f`` is
# a GNU extension, so hosts whose readlink lacks it cannot resolve paths here.
if [[ "${GITNEXUS_BIN}" -ef "${script_path}" ]]; then
    printf 'GitNexus binary resolves to wrapper: %s\n' "${GITNEXUS_BIN}" >&2
    exit 1
fi

exec "${GITNEXUS_BIN}" "$@"
